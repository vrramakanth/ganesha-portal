# Apps Script Web App deployment URL (see ../backend/README.md)
NEXT_PUBLIC_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Razorpay key_id (public — safe to expose). key_secret stays server-side
# only, in the backend's Script Properties.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXX

# Test config: set to "true" to bypass Razorpay entirely and simulate
# successful payments, so you can test the full portal before Razorpay is
# wired up. The backend needs its own matching TEST_MODE=true Script
# Property (see ../backend/README.md). Unset both to resume real payments.
NEXT_PUBLIC_TEST_MODE=false

# OAuth 2.0 Web Client ID used for volunteer Google Sign-In.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
